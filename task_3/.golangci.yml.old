run:
  timeout: 5m
  tests: true

linters-settings:
  govet:
    check-shadowing: true
  gocyclo:
    min-complexity: 10
  lll:
    line-length: 120
  gosec:
    excludes:
      - G104

linters:
  enable:
    - govet
    - errcheck
    - staticcheck
    - gosimple
    - unused
    - gocyclo
    - lll
    - gosec
    - unparam
    - errorlint
  disable:
    - maligned
    - golint

issues:
  exclude-use-default: false
  max-issues-per-linter: 0
  max-same-issues: 0
  exclude:
    - "exported .* should have comment or be unexported"
    - "package comment should be of the form"
  exclude-rules:
    - path: _test\.go
      linters:
        - gocyclo
        - errcheck
        - lll
        - gosec
        - unparam
